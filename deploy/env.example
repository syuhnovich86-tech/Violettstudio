# Copy to deploy/.env. Do not commit the real file.
VITA29_ENVIRONMENT=production
VITA29_DATABASE_URL=sqlite:////data/app/vita29.db
VITA29_MEDIA_ROOT=/data/media
VITA29_IMPORT_ROOT=/data/import/iphone
VITA29_IMPORT_OWNER_LOGIN=violet29
VITA29_IMPORT_WORKSPACE_NAME=Фото с iPhone
VITA29_GEONAMES_CITIES_PATH=/data/geonames/cities500.txt
VITA29_MINIMUM_FREE_BYTES=1073741824
VITA29_SESSION_LIFETIME_HOURS=12
# Public access is HTTPS-only. Secure cookies intentionally do not work on the old LAN HTTP URL.
VITA29_COOKIE_SECURE=true
VITA29_MAX_FILE_BYTES=2147483648
VITA29_UPLOAD_CHUNK_BYTES=1048576

# Host paths. Keep these stable when media moves to HDD.
VITA29_APP_DATA_PATH=/srv/vita29/app-data
VITA29_MEDIA_PATH=/srv/vita29/media
VITA29_HTTP_PORT=8080
VITA29_LAN_IP=192.168.1.212
