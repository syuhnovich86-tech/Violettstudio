{
  "name": "violetta-mobile",
  "description": "Мобильный медиа-центр студии VIOLETTA для iOS и Android.",
  "private": true,
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@tanstack/react-query": "^5.105.3",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-media-library": "~58.0.13",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech-recognition": "58.0.1",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "pnpm dlx expo-doctor",
    "test:api": "node scripts/smoke-api.mjs",
    "test:api:regression": "node scripts/regression-api.mjs",
    "build:android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1",
    "build:android:internal": "pnpm dlx eas-cli build --platform android --profile preview",
    "build:ios:internal": "pnpm dlx eas-cli build --platform ios --profile preview",
    "build:production": "pnpm dlx eas-cli build --platform all --profile production"
  }
}
